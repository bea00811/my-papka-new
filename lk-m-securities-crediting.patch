@@ -0,0 +1,1235 @@
+import { useEffect, useMemo, useState } from 'react';
+import { NumberFormatValues } from 'react-number-format';
+import { useNavigate } from 'react-router-dom';
+
+import {
+  BottomSheet,
+  Button,
+  CircleLoader,
+  DatePicker,
+  Input,
+  SearchSelect,
+  Text,
+} from '@aurora/components';
+import { APP_TITLE } from 'const/app';
+import { DEFAULT_DATE_VIEW_FORMAT } from 'const/date';
+import { ROUTE_SECURITIES_CREDITING_ORDER, ROUTE_TRANSFERS } from 'const/routes';
+import { DateTime } from 'luxon';
+
+import { isMobileDevice } from 'core/DeviceDetector';
+import {
+  useGetSecuritiesContractorsQuery,
+  useGetSecuritiesCreditingParamsQuery,
+  useGetSecuritiesDocTypesQuery,
+  useGetSecuritiesWriteOffParamsQuery,
+  useLazyGetSecuritiesCreditingFilesQuery,
+  useLazyGetSecuritiesCreditingQuery,
+  useSecuritiesCreditingCommitMutation,
+  useSecuritiesCreditingMutation,
+  useSecuritiesWriteOffUploadFileMutation,
+} from 'core/api/transfers';
+
+import { SECURITIES_CREDITING_PAGE_TITLE } from 'modules/Transfers/constants';
+import ArrowNextIcon from 'modules/Transfers/pages/Refill/icons/ArrowNextIcon';
+import {
+  SecuritiesContractor,
+  SecuritiesCreditingParameter,
+  SecuritiesCreditingRequestParams,
+  SecuritiesWriteOffNonSbpDetails,
+  SecuritiesWriteOffParameter,
+  SecuritiesWriteOffResponse,
+  SecuritiesWriteOffStatus,
+  WriteOffCreditType,
+} from 'modules/Transfers/types';
+
+import { HeaderPage } from 'components';
+
+import { ReactComponent as Calendar } from 'images/icons/calendarI.svg';
+import { ReactComponent as BackSvg } from 'images/icons/glyphs/back.svg';
+
+import BlockedContent from '../../components/BlockedContent';
+import styles from '../SecuritiesWriteOff/SecuritiesWriteOff.module.pcss';
+import WriteOffSupportingDocuments from '../SecuritiesWriteOff/WriteOffSupportingDocuments';
+import {
+  WriteOffFieldErrors,
+  WriteOffFormField,
+  hasWriteOffFieldErrors,
+  parseWriteOffCheckResult,
+} from '../SecuritiesWriteOff/writeOffCheckResult';
+import {
+  DEFAULT_WRITEOFF_ERROR_MESSAGE,
+  getWriteOffErrorMessage,
+} from '../SecuritiesWriteOff/writeOffErrors';
+import {
+  CREDIT_TYPE_OPTIONS,
+  EMPTY_NON_SBP,
+  filterByQuery,
+  formatQuantity,
+  getContractorIdentifier,
+  getQuantityFractionPart,
+  getRequestGuidFromResponse,
+  mapContractorToOption,
+  mapInstrumentToOption,
+  normalizeQuantityFromNumberFormat,
+  parseFormDate,
+  sanitizeLatin,
+  toIsoDate,
+  toQuantityNumber,
+} from '../SecuritiesWriteOff/writeOffFormHelpers';
+import {
+  WRITEOFF_STATUS_POLL_INTERVAL_MS,
+  WRITEOFF_STATUS_POLL_TIMEOUT_MS,
+  getWriteOffStatus,
+  isWriteOffSigningStatus,
+  isWriteOffStatusReady,
+  sleep,
+} from '../SecuritiesWriteOff/writeOffStatus';
+import WriteOffFailed from '../SecuritiesWriteOffOrder/WriteOffFailed';
+
+const ACCOUNT_HINT = 'Счёт депо / раздел (договор)';
+const FAILED_TITLE = 'Поручение на зачисление ценных бумаг не выполнено.';
+
+type CreditingAccountOption = {
+  depoSubAccountId: number;
+  depoAccount: string;
+  depoSection: string;
+  agreement: string;
+};
+
+/** Все разделы всех мест расчётов одним списком, без дублей по depoSubAccountId. */
+const getCreditingAccounts = (params: SecuritiesCreditingParameter[]) => {
+  const byId = new Map<number, CreditingAccountOption>();
+
+  params.forEach((param) =>
+    param.accounts.forEach((account) =>
+      account.sections.forEach((section) => {
+        if (!byId.has(section.depoSubAccountId)) {
+          byId.set(section.depoSubAccountId, {
+            depoSubAccountId: section.depoSubAccountId,
+            depoAccount: account.depoAccount,
+            depoSection: section.depoSection,
+            agreement: account.agreement,
+          });
+        }
+      }),
+    ),
+  );
+
+  return Array.from(byId.values());
+};
+
+const getAccountLabel = (account: CreditingAccountOption) =>
+  `${account.depoAccount} / ${account.depoSection}`;
+
+const hasSubAccount = (param: SecuritiesCreditingParameter, depoSubAccountId: number) =>
+  param.accounts.some((account) =>
+    account.sections.some((section) => section.depoSubAccountId === depoSubAccountId),
+  );
+
+const SecuritiesCrediting = () => {
+  const navigate = useNavigate();
+  const isMobile = isMobileDevice();
+  const [instrumentValue, setInstrumentValue] = useState('');
+  const [isinValue, setIsinValue] = useState('');
+  const [accountValue, setAccountValue] = useState('');
+  const [quantityValue, setQuantityValue] = useState('');
+  const [selectedInstrument, setSelectedInstrument] = useState<SecuritiesWriteOffParameter | null>(
+    null,
+  );
+  const [selectedAccount, setSelectedAccount] = useState<CreditingAccountOption | null>(null);
+  const [selectedDepo, setSelectedDepo] = useState<SecuritiesCreditingParameter | null>(null);
+  const [contractorValue, setContractorValue] = useState('');
+  const [selectedContractor, setSelectedContractor] = useState<SecuritiesContractor | null>(null);
+  const [details, setDetails] = useState<SecuritiesWriteOffNonSbpDetails>(EMPTY_NON_SBP);
+  const [openDateField, setOpenDateField] = useState<
+    'dealDate' | 'settlementDate' | 'contractDate' | null
+  >(null);
+
+  const {
+    data: instrumentsParams,
+    isLoading,
+    isError: isParamsError,
+  } = useGetSecuritiesWriteOffParamsQuery(undefined, { refetchOnMountOrArgChange: true });
+  const {
+    data: creditingParamsData,
+    isLoading: isCreditingParamsLoading,
+    isFetching: isCreditingParamsFetching,
+  } = useGetSecuritiesCreditingParamsQuery(
+    { depoInstrumentId: selectedInstrument?.depoInstrumentId ?? 0 },
+    { skip: !selectedInstrument, refetchOnMountOrArgChange: true },
+  );
+  const isWithRights = details.creditType === 'WITH_RIGHTS';
+  const {
+    data: docTypesData,
+    isLoading: isDocTypesLoading,
+    isFetching: isDocTypesFetching,
+  } = useGetSecuritiesDocTypesQuery(
+    details.creditType ? { changeOwnership: isWithRights } : undefined,
+    { skip: !details.creditType, refetchOnMountOrArgChange: true },
+  );
+  const docTypes = docTypesData ?? [];
+  const {
+    data: contractorsData,
+    isLoading: isContractorsLoading,
+    isFetching: isContractorsFetching,
+  } = useGetSecuritiesContractorsQuery(undefined, { refetchOnMountOrArgChange: true });
+  const [crediting, { isLoading: isCreditingLoading }] = useSecuritiesCreditingMutation();
+  const [uploadFile] = useSecuritiesWriteOffUploadFileMutation();
+  const [commitCrediting, { isLoading: isCommitLoading }] = useSecuritiesCreditingCommitMutation();
+  const [getCreditingDetails] = useLazyGetSecuritiesCreditingQuery();
+  const [getCreditingFiles] = useLazyGetSecuritiesCreditingFilesQuery();
+  const [isStatusPolling, setIsStatusPolling] = useState(false);
+  const [isUploadingAttachments, setIsUploadingAttachments] = useState(false);
+  const [step, setStep] = useState<'FORM' | 'FAILED'>('FORM');
+  const [errorMessage, setErrorMessage] = useState(DEFAULT_WRITEOFF_ERROR_MESSAGE);
+  const [fieldErrors, setFieldErrors] = useState<WriteOffFieldErrors>({});
+  const [attachmentFiles, setAttachmentFiles] = useState<File[]>([]);
+  const [attachmentStatuses, setAttachmentStatuses] = useState<
+    Array<'pending' | 'success' | 'failed'>
+  >([]);
+  const [draftRequestGuid, setDraftRequestGuid] = useState<string | null>(null);
+  const isNextBusy =
+    isCreditingLoading || isStatusPolling || isUploadingAttachments || isCommitLoading;
+
+  const clearFieldError = (field: WriteOffFormField) => {
+    setFieldErrors((prev) => {
+      if (!prev[field]) {
+        return prev;
+      }
+
+      const next = { ...prev };
+      delete next[field];
+      return next;
+    });
+  };
+
+  const instruments = instrumentsParams?.writeOffParameters ?? [];
+  const creditingParams = creditingParamsData ?? [];
+  const contractors = contractorsData ?? [];
+  const accounts = useMemo(() => getCreditingAccounts(creditingParams), [creditingParams]);
+  const depos = useMemo(
+    () =>
+      selectedAccount
+        ? creditingParams.filter((param) => hasSubAccount(param, selectedAccount.depoSubAccountId))
+        : [],
+    [creditingParams, selectedAccount],
+  );
+  const isChangeOwnershipAllowed = selectedDepo?.changeOwnershipAllowed ?? true;
+  const creditTypeOptions = isChangeOwnershipAllowed
+    ? CREDIT_TYPE_OPTIONS
+    : CREDIT_TYPE_OPTIONS.filter((item) => item.id !== 'WITH_RIGHTS');
+  const emptyMessage = isLoading ? 'Загрузка...' : 'Ничего не найдено';
+
+  useEffect(() => {
+    document.title = `${SECURITIES_CREDITING_PAGE_TITLE} — ${APP_TITLE}`;
+  }, []);
+
+  const instrumentList = useMemo(() => {
+    const filtered = filterByQuery(instruments, instrumentValue, [
+      'name',
+      'isin',
+      'issuerName',
+    ]).map((instrument) => mapInstrumentToOption(instrument));
+
+    if (
+      selectedInstrument &&
+      !filtered.some((item) => item.id === selectedInstrument.depoInstrumentId)
+    ) {
+      return [mapInstrumentToOption(selectedInstrument), ...filtered];
+    }
+
+    return filtered;
+  }, [instruments, instrumentValue, selectedInstrument]);
+
+  const accountList = useMemo(() => {
+    const normalizedQuery = accountValue.trim().toLowerCase();
+
+    return (
+      normalizedQuery && !selectedAccount
+        ? accounts.filter((account) =>
+            getAccountLabel(account).toLowerCase().includes(normalizedQuery),
+          )
+        : accounts
+    ).map((account) => ({
+      id: account.depoSubAccountId,
+      value: getAccountLabel(account),
+      description: account.agreement,
+    }));
+  }, [accounts, accountValue, selectedAccount]);
+
+  const depoList = useMemo(
+    () => depos.map((param) => ({ id: param.depo, value: param.name })),
+    [depos],
+  );
+
+  const contractorList = useMemo(() => {
+    const normalizedQuery = contractorValue.trim().toLowerCase();
+    const filtered = (
+      normalizedQuery
+        ? contractors.filter((contractor) =>
+            contractor.name.toLowerCase().includes(normalizedQuery),
+          )
+        : contractors
+    ).map((contractor, index) => mapContractorToOption(contractor, index));
+
+    if (selectedContractor && !filtered.some((item) => item.value === selectedContractor.name)) {
+      return [mapContractorToOption(selectedContractor, -1), ...filtered];
+    }
+
+    return filtered;
+  }, [contractors, contractorValue, selectedContractor]);
+
+  const patchDetails = (patch: Partial<SecuritiesWriteOffNonSbpDetails>) => {
+    setDetails((prev) => ({ ...prev, ...patch }));
+  };
+
+  const docTypeOptions = useMemo(
+    () => docTypes.map((item) => ({ id: item.id, value: item.name })),
+    [docTypes],
+  );
+  const selectedDocType = useMemo(
+    () => docTypes.find((item) => item.id === details.docTypeId) ?? null,
+    [docTypes, details.docTypeId],
+  );
+  const needDocTypeOther = Boolean(selectedDocType?.needComment);
+
+  useEffect(() => {
+    if (!details.docTypeId || docTypes.some((item) => item.id === details.docTypeId)) {
+      return;
+    }
+
+    patchDetails({ docTypeId: null, docTypeOther: '' });
+  }, [docTypes, details.docTypeId]);
+
+  useEffect(() => {
+    if (details.creditType !== 'WITHOUT_RIGHTS' || details.docTypeId || docTypes.length !== 1) {
+      return;
+    }
+
+    const [preferred] = docTypes;
+    clearFieldError('docTypeId');
+    patchDetails({
+      docTypeId: preferred.id,
+      docTypeOther: preferred.needComment ? details.docTypeOther : '',
+    });
+  }, [docTypes, details.creditType, details.docTypeId, details.docTypeOther]);
+
+  const selectCreditType = (creditType: WriteOffCreditType | '') => {
+    clearFieldError('creditType');
+    clearFieldError('docTypeId');
+    clearFieldError('docTypeOther');
+    patchDetails({
+      creditType,
+      docTypeId: null,
+      docTypeOther: '',
+      ...(creditType === 'WITH_RIGHTS' ? {} : { supplierName: '', dealAmount: '' }),
+    });
+  };
+
+  const selectDepo = (depo: SecuritiesCreditingParameter | null) => {
+    setSelectedDepo(depo);
+    if (depo && !depo.changeOwnershipAllowed && details.creditType === 'WITH_RIGHTS') {
+      selectCreditType('');
+    }
+  };
+
+  const selectAccount = (account: CreditingAccountOption | null) => {
+    clearFieldError('account');
+    setSelectedAccount(account);
+    setAccountValue(account ? getAccountLabel(account) : '');
+    selectDepo(null);
+  };
+
+  const selectInstrument = (instrument: SecuritiesWriteOffParameter | null) => {
+    clearFieldError('instrument');
+    setSelectedInstrument(instrument);
+    setInstrumentValue(instrument?.name ?? '');
+    setIsinValue(instrument?.isin ?? '');
+    setQuantityValue('');
+    selectAccount(null);
+  };
+
+  const selectContractor = (contractor: SecuritiesContractor | null) => {
+    clearFieldError('contractor');
+    setSelectedContractor(contractor);
+    setContractorValue(contractor?.name ?? '');
+    if (contractor) {
+      clearFieldError('contractorID');
+      clearFieldError('depoNumber');
+      clearFieldError('depoDivision');
+      patchDetails({
+        contractorID: getContractorIdentifier(contractor),
+        depoNumber: contractor.depoNumber ?? '',
+        depoDivision: contractor.depoDivision ?? '',
+      });
+    }
+  };
+
+  useEffect(() => {
+    if (instruments.length === 1 && !selectedInstrument) {
+      selectInstrument(instruments[0]);
+    }
+  }, [instruments, selectedInstrument]);
+
+  useEffect(() => {
+    if (accounts.length === 1 && !selectedAccount) {
+      selectAccount(accounts[0]);
+    }
+  }, [accounts, selectedAccount]);
+
+  useEffect(() => {
+    if (depos.length === 1 && !selectedDepo) {
+      selectDepo(depos[0]);
+    }
+  }, [depos, selectedDepo]);
+
+  useEffect(() => {
+    if (contractors.length === 1 && !selectedContractor) {
+      selectContractor(contractors[0]);
+    }
+  }, [contractors, selectedContractor]);
+
+  const preventClearButtonFocus = (event: any) => {
+    const target = event.target as HTMLElement | null;
+    if (target?.closest('[class*="Input-module_icon-clear"]')) {
+      event.preventDefault();
+    }
+  };
+
+  const clearSearchSelect = (clear: () => void) => () => {
+    clear();
+    if (document.activeElement instanceof HTMLElement) {
+      document.activeElement.blur();
+    }
+  };
+
+  const quantityFractionPart = getQuantityFractionPart(selectedInstrument?.quantityFractionPart);
+  const quantityNumber = toQuantityNumber(quantityValue);
+  const isQuantityNonPositive = quantityNumber != null && quantityNumber <= 0;
+
+  const handleQuantityValueChange = (values: NumberFormatValues) => {
+    clearFieldError('quantity');
+    setQuantityValue(normalizeQuantityFromNumberFormat(values, quantityFractionPart));
+  };
+
+  const handleQuantityBlur = () => {
+    const parsed = toQuantityNumber(quantityValue);
+    if (parsed == null) {
+      return;
+    }
+
+    setQuantityValue(formatQuantity(parsed, quantityFractionPart));
+  };
+
+  const formPayload = useMemo(
+    () => ({
+      instrument: selectedInstrument
+        ? {
+            depoInstrumentId: selectedInstrument.depoInstrumentId,
+            name: selectedInstrument.name,
+            isin: selectedInstrument.isin,
+            issuerName: selectedInstrument.issuerName,
+            instrumentImageName: selectedInstrument.instrumentImageName,
+          }
+        : null,
+      quantity: quantityValue,
+      contractor: selectedContractor
+        ? { id: selectedContractor.id, name: selectedContractor.name }
+        : null,
+    }),
+    [selectedInstrument, quantityValue, selectedContractor],
+  );
+
+  const handleBackClick = () => {
+    navigate(ROUTE_TRANSFERS);
