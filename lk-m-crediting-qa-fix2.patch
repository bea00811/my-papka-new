+/**
+ * DENIED — скрыть плашку
+ * BLOCKED — показать плашку, форму не открывать
+ * GRANTED / NONACTIVE — показать плашку и форму
+ */
+export const getSecuritiesCreditingPermission = () => {
+  const permission = getSecuritiesPermission('PERSON_NONTRADE_SECURITY_REFILL_EXT');
+
+  return {
+    get isVisible() {
+      return permission.isGranted || permission.isBlocked;
+    },
+    get isGranted() {
+      return permission.isGranted;
+    },
+    get isDenied() {
+      return permission.isDenied;
+    },
+    get isBlocked() {
+      return permission.isBlocked;
+    },
+  };
+};
