diff --git a/src/const/writeoffFiles.ts b/src/const/writeoffFiles.ts
new file mode 100644
--- /dev/null
+++ b/src/const/writeoffFiles.ts
@@ -0,0 +1,59 @@
+export const WRITEOFF_FILE_EXT_ACCEPT = '.jpg, .jpeg, .png, .pdf, .doc, .docx, .xls, .xlsx';
+export const WRITEOFF_FILE_EXT_ACCEPT_ARRAY = [
+  '.jpg',
+  '.jpeg',
+  '.png',
+  '.pdf',
+  '.doc',
+  '.docx',
+  '.xls',
+  '.xlsx',
+];
+export const WRITEOFF_MAX_UPLOAD_FILES_COUNT = 3;
+export const WRITEOFF_MAX_FILE_UPLOAD_SIZE_BYTES = 8_000_000;
+export const WRITEOFF_FILE_SIZE_ERROR_MSG = 'Максимальный размер одного файла — 8 Мб';
+export const WRITEOFF_FILE_COUNT_ERROR_MSG = 'Можно загрузить не более 3 файлов';
+export const WRITEOFF_FILE_FORMAT_ERROR_MSG = 'Неверный формат файла';
+
+export const getWriteOffFileExtension = (fileName: string) =>
+  `.${fileName.split('.').pop()?.toLowerCase() ?? ''}`;
+
+export const filterValidWriteOffUploadFiles = (
+  files: File[],
+  existingFiles: File[] = [],
+): {
+  validFiles: File[];
+  hasSizeError: boolean;
+  hasFormatError: boolean;
+  hasCountError: boolean;
+} => {
+  let filesCount = existingFiles.length;
+  let hasSizeError = false;
+  let hasFormatError = false;
+  let hasCountError = false;
+  const validFiles: File[] = [];
+
+  files.forEach((file) => {
+    const fileExtension = getWriteOffFileExtension(file.name);
+
+    if (!WRITEOFF_FILE_EXT_ACCEPT_ARRAY.includes(fileExtension)) {
+      hasFormatError = true;
+      return;
+    }
+
+    if (file.size > WRITEOFF_MAX_FILE_UPLOAD_SIZE_BYTES) {
+      hasSizeError = true;
+      return;
+    }
+
+    if (filesCount >= WRITEOFF_MAX_UPLOAD_FILES_COUNT) {
+      hasCountError = true;
+      return;
+    }
+
+    filesCount += 1;
+    validFiles.push(file);
+  });
+
+  return { validFiles, hasSizeError, hasFormatError, hasCountError };
+};
diff --git a/src/modules/Transfers/pages/SecuritiesWriteOff/WriteOffSupportingDocuments.tsx b/src/modules/Transfers/pages/SecuritiesWriteOff/WriteOffSupportingDocuments.tsx
new file mode 100644
--- /dev/null
+++ b/src/modules/Transfers/pages/SecuritiesWriteOff/WriteOffSupportingDocuments.tsx
@@ -0,0 +1,127 @@
+import React, { useCallback, useRef, useState } from 'react';
+
+import { BottomSheet, Button, FileUploader, Text } from '@aurora/components';
+import {
+  WRITEOFF_FILE_COUNT_ERROR_MSG,
+  WRITEOFF_FILE_EXT_ACCEPT,
+  WRITEOFF_FILE_FORMAT_ERROR_MSG,
+  WRITEOFF_FILE_SIZE_ERROR_MSG,
+  WRITEOFF_MAX_UPLOAD_FILES_COUNT,
+  filterValidWriteOffUploadFiles,
+} from 'const/writeoffFiles';
+
+import { createAlertNotification } from 'components';
+
+import styles from './WriteOffSupportingDocuments.module.pcss';
+
+type Props = {
+  files: File[];
+  onFilesChange: (files: File[]) => void;
+  disabled?: boolean;
+};
+
+const HELP_STUB_TEXT =
+  'Полный перечень подтверждающих документов будет добавлен позже.';
+
+const mergeSelectedFiles = (prev: File[], nextFiles: File[]) => {
+  const isRemoveOperation =
+    nextFiles.length < prev.length && nextFiles.every((file) => prev.includes(file));
+
+  if (isRemoveOperation) {
+    return nextFiles;
+  }
+
+  return [...prev, ...nextFiles.filter((file) => !prev.includes(file))].slice(
+    0,
+    WRITEOFF_MAX_UPLOAD_FILES_COUNT,
+  );
+};
+
+const WriteOffSupportingDocuments: React.FC<Props> = ({ files, onFilesChange, disabled }) => {
+  const [isHelpOpen, setIsHelpOpen] = useState(false);
+  const validationRejectedRef = useRef(false);
+
+  const onValidateFiles = useCallback(
+    async (incomingFiles: File[]) => {
+      const { validFiles, hasSizeError, hasFormatError, hasCountError } =
+        filterValidWriteOffUploadFiles(incomingFiles, files);
+
+      if (incomingFiles.length > 0 && validFiles.length === 0) {
+        validationRejectedRef.current = true;
+      }
+
+      if (hasSizeError) {
+        createAlertNotification({ text: WRITEOFF_FILE_SIZE_ERROR_MSG, ms: 3000, status: 'error' });
+      }
+      if (hasCountError) {
+        createAlertNotification({ text: WRITEOFF_FILE_COUNT_ERROR_MSG, ms: 3000, status: 'error' });
+      }
+      if (hasFormatError) {
+        createAlertNotification({
+          text: WRITEOFF_FILE_FORMAT_ERROR_MSG,
+          ms: 3000,
+          status: 'error',
+        });
+      }
+
+      return validFiles;
+    },
+    [files],
+  );
+
+  const handleChange = useCallback(
+    (nextFiles: File[]) => {
+      if (disabled) {
+        return;
+      }
+
+      if (validationRejectedRef.current && nextFiles.length === 0) {
+        validationRejectedRef.current = false;
+        return;
+      }
+
+      onFilesChange(mergeSelectedFiles(files, nextFiles));
+    },
+    [disabled, files, onFilesChange],
+  );
+
+  return (
+    <div className={styles.section}>
+      <Text className={styles.title}>Подтверждающие документы</Text>
+      <Text className={styles.hint} type="footnoteRegular" color="colorForeground2">
+        Обратите внимание: для некоторых типов операций требуются подтверждающие документы.
+        Ознакомиться с полным перечнем документов можно{' '}
+        <button type="button" className={styles.helpLink} onClick={() => setIsHelpOpen(true)}>
+          здесь
+        </button>
+      </Text>
+      <Text className={styles.hint} type="footnoteRegular" color="colorForeground2">
+        Допускаются файлы в форматах JPG/JPEG, PNG, PDF, DOC/DOCX, XLS/XLSX. Размер одного файла не
+        должен превышать 8 Мб.
+      </Text>
+
+      <div className={disabled ? styles.uploaderLocked : undefined}>
+        <FileUploader
+          listShape="cardCell"
+          mode="attach"
+          variant="button"
+          accept={WRITEOFF_FILE_EXT_ACCEPT}
+          filesLimit={WRITEOFF_MAX_UPLOAD_FILES_COUNT}
+          onChange={handleChange}
+          validateFiles={onValidateFiles}
+          className={styles.uploader}
+        />
+      </div>
+
+      <BottomSheet open={isHelpOpen} onDismiss={() => setIsHelpOpen(false)}>
+        <div className={styles.helpContent}>
+          <Text type="title">Подтверждающие документы</Text>
+          <Text type="bodyRegular">{HELP_STUB_TEXT}</Text>
+          <Button onClick={() => setIsHelpOpen(false)}>Понятно</Button>
+        </div>
+      </BottomSheet>
+    </div>
+  );
+};
+
+export default WriteOffSupportingDocuments;
